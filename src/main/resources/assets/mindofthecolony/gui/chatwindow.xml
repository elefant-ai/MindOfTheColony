<?xml version="1.0" encoding="UTF-8"?>
<window xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" size="280 244"
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/ldtteam/BlockUI/version/main/src/main/resources/assets/blockui/gui/block_ui.xsd">

    <!-- Background -->
    <image source="minecolonies:textures/gui/builderhut/builder_paper.png" pos="0 0" size="280 244"/>

    <!-- Title -->
    <text id="title" size="240 12" pos="20 16" color="black" textalign="MIDDLE"/>

    <!-- Chat history area -->
    <text id="chatHistory" size="240 152" pos="20 34" color="black" wrap="true" textscale="0.8" textalign="TOP_LEFT"/>

    <!-- Input field -->
    <input id="chatInput" size="185 16" pos="20 194" maxlength="200"/>

    <!-- Send button -->
    <button id="sendButton" size="50 16" pos="210 194"
            source="minecolonies:textures/gui/citizen/colonist_button_medium.png"
            label="Send" textcolor="black" texthovercolor="gray"/>

    <!-- Close button -->
    <button id="closeButton" size="14 14" pos="258 10"
            source="minecolonies:textures/gui/citizen/colonist_button_medium.png"
            label="X" textcolor="black" texthovercolor="gray"/>
</window>
